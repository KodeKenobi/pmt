# GITHUB TOKENS
GITHUB_TOKEN="your-github-token"

# NEXT CREDENTIALS
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Database (Supabase / PostgreSQL)
# Set this to your Supabase Postgres connection string (found in Project Settings → Database → Connection string)
DATABASE_URL="postgresql://<user>:<password>@<host>:5432/<database>?sslmode=require"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-public-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Resend (preferred for app email delivery)
EMAIL_PROVIDER="resend"
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="onboarding@resend.dev"
RESEND_FROM_NAME="Lighthouse Project Management"

# Feedback email ingest webhook security
# Incoming mailbox parser/webhook must send this value in x-feedback-secret header
FEEDBACK_INGEST_SECRET="replace-with-a-long-random-secret"

# Sentry (optional)
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_ENVIRONMENT="development"
SENTRY_RELEASE=""
SENTRY_URL="https://sentry.io"

# SMTP (use only when EMAIL_PROVIDER="smtp")
SMTP_HOST="smtp.your-provider.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="smtp-user@your-domain.com"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM_EMAIL="noreply@your-domain.com"
SMTP_FROM_NAME="Lighthouse Project Management"

# Environment
NODE_ENV="development"
