{
  "name": "project-management-tool",
  "version": "0.1.0",
  "description": "Lighthouse Project Management desktop app",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "main": "electron/main.js",
  "author": "Lighthouse",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "seed": "tsx src/scripts/seedTickets.ts",
    "test": "node --no-deprecation ./node_modules/jest/bin/jest.js",
    "test:ci": "node --no-deprecation ./node_modules/jest/bin/jest.js --ci --passWithNoTests",
    "test:watch": "node --no-deprecation ./node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --no-deprecation ./node_modules/jest/bin/jest.js --coverage",
    "test:unit": "node --no-deprecation ./node_modules/jest/bin/jest.js tests/unit --ci --passWithNoTests",
    "test:integration": "node --no-deprecation ./node_modules/jest/bin/jest.js tests/integration --ci --passWithNoTests",
    "test:workflow": "node --no-deprecation ./node_modules/jest/bin/jest.js tests/integration/api/individual/workflow --ci --passWithNoTests",
    "test:component": "node --no-deprecation ./node_modules/jest/bin/jest.js tests/component --ci --passWithNoTests",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "clean": "rm -rf .next node_modules/.cache",
    "analyze": "ANALYZE=true npm run build",
    "docker:build": "docker build -t pm-tool .",
    "docker:run": "docker run -p 3000:3000 pm-tool",
    "vercel:deploy": "vercel --prod",
    "pm2:start": "pm2 start npm --name pm-tool -- start",
    "pm2:stop": "pm2 stop pm-tool",
    "pm2:restart": "pm2 restart pm-tool",
    "pm2:logs": "pm2 logs pm-tool",
    "github:fetch-prs": "node scripts/fetch-all-prs.js",
    "github:audit-pr-ticket-links": "node scripts/audit-pr-ticket-links.js",
    "monitoring:check-sentry-inbox": "node scripts/check-sentry-dev-inbox.js",
    "sign:windows": "powershell -ExecutionPolicy Bypass -File ./scripts/sign-windows.ps1",
    "sign:windows:example": "powershell -ExecutionPolicy Bypass -Command \"$env:SIGN_PFX_PASSWORD='EnablePMT-Dev-2026!'; ./scripts/sign-windows.ps1 -FilePath './dist/EnablePMT.exe'\"",
    "electron:dev": "concurrently --kill-others \"pnpm dev\" \"wait-on http://localhost:3000 && cross-env NODE_ENV=development electron electron/main.js\"",
    "electron:build": "cross-env ELECTRON_BUILD=1 next build && electron-builder",
    "electron:build:win": "cross-env ELECTRON_BUILD=1 next build && electron-builder --win",
    "electron:build:mac": "cross-env ELECTRON_BUILD=1 next build && electron-builder --mac",
    "electron:build:linux": "cross-env ELECTRON_BUILD=1 next build && electron-builder --linux",
    "electron:dist:win": "cross-env ELECTRON_BUILD=1 WIN_CSC_LINK=certs/enable-pmt-dev-signing.pfx WIN_CSC_KEY_PASSWORD=EnablePMT-Dev-2026! next build && electron-builder --win --publish never",
    "electron:dist:win:unsigned": "cross-env ELECTRON_BUILD=1 next build && electron-builder --win --publish never",
    "electron:publish": "cross-env ELECTRON_BUILD=1 next build && electron-builder --win --publish always",
    "backup:db": "pg_dump $DATABASE_URL > backup_$(date +%Y%m%d_%H%M%S).sql",
    "health": "curl -f http://localhost:3000/api/health || exit 1"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@phosphor-icons/react": "^2.1.10",
    "@reduxjs/toolkit": "^2.12.0",
    "@sentry/nextjs": "^10.55.0",
    "@supabase/ssr": "^0.0.10",
    "@supabase/supabase-js": "^2.33.0",
    "@tiptap/extension-image": "^3.23.6",
    "@tiptap/extension-link": "^3.23.6",
    "@tiptap/extension-underline": "^3.23.6",
    "@tiptap/react": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@uiw/react-md-editor": "^4.1.1",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.3.0",
    "electron-updater": "^6.8.9",
    "framer-motion": "^12.23.6",
    "imapflow": "^1.3.4",
    "import-in-the-middle": "^3.0.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.525.0",
    "next": "15.5.18",
    "next-remove-imports": "^1.0.13",
    "nodemailer": "^9.0.1",
    "octokit": "^5.0.5",
    "radix-ui": "^1.4.3",
    "react": "19.1.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.1.0",
    "react-redux": "^9.3.0",
    "recharts": "^2.15.0",
    "require-in-the-middle": "^8.0.1",
    "resend": "^6.12.4",
    "shadcn": "^4.8.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "tw-elements-react": "^1.0.0-alpha-end"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.54.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "electron-is-dev": "^3.0.1",
    "eslint": "^9",
    "eslint-config-next": "15.4.10",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "tailwindcss": "^4",
    "tsx": "^4.7.0",
    "typescript": "^5",
    "wait-on": "^9.0.10"
  }
}
